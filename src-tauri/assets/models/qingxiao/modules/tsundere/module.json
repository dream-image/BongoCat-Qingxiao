  "actions": {
    "remind": {
      "label": {
        "zh-CN": "提醒我休息",
        "en-US": "Remind me to rest"
      },
      "animation": "remind",
      "priority": 45,
      "cooldownMs": 60000,
      "interruptible": true,
      "stateEffect": {
        "when": "finished",
        "priority": 40,
        "set": {
          "mood": "concerned"
        },
        "lifetime": {
          "type": "duration",
          "durationMs": 300000
        }
      },
      "dialogue": {
        "chance": 1,
        "delayMs": 100,
        "durationMs": 2500,
        "anchor": {
          "x": 350,
          "y": 158
        },
        "lines": [
          {
            "text": {
              "zh-CN": "该休息了。",
              "en-US": "Time for a break."
            },
            "weight": 3
          },
          {
            "text": {
              "zh-CN": "别让我再提醒。",
              "en-US": "Don't make me repeat myself."
            },
            "weight": 2
          },
          {
            "text": {
              "zh-CN": "还不睡？",
              "en-US": "Still awake?"
            },
            "weight": 1
          }
        ]
      },
      "stateDialogues": [
        {
          "priority": 90,
          "match": {
            "form": "attack"
          },
          "dialogue": {
            "delayMs": 100,
            "durationMs": 2500,
            "anchor": {
              "x": 350,
              "y": 158
            },
            "lines": [
              {
                "text": {
                  "zh-CN": "休息。恢复体力也是战术。",
                  "en-US": "Rest. Recovery is part of battle."
                }
              }
            ]
          }
        },
        {
          "priority": 90,
          "match": {
            "form": "demon"
          },
          "dialogue": {
            "delayMs": 120,
            "durationMs": 2600,
            "anchor": {
              "x": 350,
              "y": 158
            },
            "lines": [
              {
                "text": {
                  "zh-CN": "再逞强，我就替你关掉它。",
                  "en-US": "Keep pushing and I'll shut it down for you."
                }
              }
            ]
          }
        }
      ],
      "stateAnimations": [
        {
          "priority": 90,
          "match": {
            "form": "attack"
          },
          "animation": "attack-remind"
        },
        {
          "priority": 90,
          "match": {
            "form": "demon"
          },
          "animation": "demon-remind"
        }
      ]
    },
    "hmph": {
      "label": {
        "zh-CN": "傲娇轻哼",
        "en-US": "A haughty hmph"
      },
      "animation": "hmph",
      "priority": 34,
      "cooldownMs": 12000,
      "interruptible": true,
      "stateEffect": {
        "when": "finished",
        "priority": 40,
        "set": {
          "mood": "annoyed"
        },
        "lifetime": {
          "type": "duration",
          "durationMs": 90000
        }
      },
      "audio": {
        "file": "@model/audio/common-voice-08-question.wem",
        "delayMs": 100,
        "volume": 0.88
      },
      "dialogue": {
        "chance": 1,
        "delayMs": 100,
        "durationMs": 2300,
        "anchor": {
          "x": 352,
          "y": 170
        },
        "lines": [
          {
            "text": {
              "zh-CN": "……有什么不妥吗？",
              "en-US": "...Is something wrong?"
            },
            "weight": 1
          }
        ]
      },
      "stateAnimations": [
        {
          "priority": 90,
          "match": {
            "form": "attack"
          },
          "animation": "attack-hmph"
        },
        {
          "priority": 90,
          "match": {
            "form": "demon"
          },
          "animation": "demon-hmph"
        }
      ]
    },
    "short-return-hmph": {
      "label": {
        "zh-CN": "嘴硬迎你",
        "en-US": "Hmph on your return"
      },
      "animation": "hmph",
      "priority": 36,
      "cooldownMs": 21600000,
      "interruptible": true,
      "stateEffect": {
        "when": "finished",
        "priority": 30,
        "set": {
          "mood": "annoyed"
        },
        "lifetime": {
          "type": "duration",
          "durationMs": 90000
        }
      },
      "dialogue": {
        "chance": 1,
        "delayMs": 100,
        "durationMs": 2400,
        "anchor": {
          "x": 352,
          "y": 170
        },
        "lines": [
          {
            "text": {
              "zh-CN": "才二十分钟就回来找我？……随你。",
              "en-US": "Back for me after only twenty minutes? ...Suit yourself."
            },
            "weight": 3
          },
          {
            "text": {
              "zh-CN": "总算回来了。我可没在数时辰。",
              "en-US": "You're finally back. I wasn't counting the hours."
            },
            "weight": 2
          }
        ]
      },
      "stateAnimations": [
        {
          "priority": 90,
          "match": {
            "form": "attack"
          },
          "animation": "attack-hmph"
        },
        {
          "priority": 90,
          "match": {
            "form": "demon"
          },
          "animation": "demon-hmph"
        }
      ]
    },
    "mouse-fuss": {
      "label": {
        "zh-CN": "鼠标闹腾",
        "en-US": "Mouse fuss"
      },
      "animation": "hmph",
      "priority": 32,
      "cooldownMs": 600000,
      "interruptible": true,
      "stateEffect": {
        "when": "finished",
        "priority": 35,
        "set": {
          "mood": "annoyed"
        },
        "lifetime": {
          "type": "duration",
          "durationMs": 90000
        }
      },
      "dialogue": {
        "chance": 0.85,
        "delayMs": 100,
        "durationMs": 2200,
        "anchor": {
          "x": 352,
          "y": 170
        },
        "lines": [
          {
            "text": {
              "zh-CN": "晃来晃去，你的手不累么？",
              "en-US": "Back and forth—doesn't your hand get tired?"
            },
            "weight": 3
          },
          {
            "text": {
              "zh-CN": "安分一点。晃得琴弦都烦了。",
              "en-US": "Settle down. Even the strings are annoyed by all that motion."
            },
            "weight": 2
          }
        ]
      },
      "stateAnimations": [
        {
          "priority": 90,
          "match": {
            "form": "attack"
          },
          "animation": "attack-hmph"
        },
        {
          "priority": 90,
          "match": {
            "form": "demon"
          },
          "animation": "demon-hmph"
        }
      ]
    },
    "work-break-reminder": {
      "label": {
        "zh-CN": "专注休息提醒",
        "en-US": "Focus break reminder"
      },
      "animation": "remind",
      "priority": 46,
      "cooldownMs": 2700000,
      "interruptible": true,
      "stateEffect": {
        "when": "finished",
        "priority": 50,
        "set": {
          "mood": "concerned"
        },
        "lifetime": {
          "type": "duration",
          "durationMs": 300000
        }
      },
      "dialogue": {
        "chance": 1,
        "delayMs": 100,
        "durationMs": 2600,
        "anchor": {
          "x": 350,
          "y": 158
        },
        "lines": [
          {
            "text": {
              "zh-CN": "五十分钟了。起来走走——不是在担心你。",
              "en-US": "Fifty minutes. Get up and walk—I'm not worried about you."
            },
            "weight": 3
          },
          {
            "text": {
              "zh-CN": "眼睛离远些。你若累坏，反倒扰我清静。",
              "en-US": "Rest your eyes. If you wear yourself out, you'll disturb my peace."
            },
            "weight": 2
          }
        ]
      },
      "stateAnimations": [
        {
          "priority": 90,
          "match": {
            "form": "attack"
          },
          "animation": "attack-remind"
        },
        {
          "priority": 90,
          "match": {
            "form": "demon"
          },
          "animation": "demon-remind"
        }
      ]
    },
    "idle-hmph": {
      "label": {
        "zh-CN": "空闲轻哼",
        "en-US": "Idle hmph"
      },
      "animation": "hmph",
      "priority": 20,
      "cooldownMs": 600000,
      "interruptible": true,
      "dialogue": {
        "chance": 0.45,
        "delayMs": 120,
        "durationMs": 2100,
        "anchor": {
          "x": 352,
          "y": 170
        },
        "lines": [
          {
            "text": {
              "zh-CN": "安静得过分了。……我只是随口一说。",
              "en-US": "It's far too quiet. ...Just an observation."
            },
            "weight": 3
          },
          {
            "text": {
              "zh-CN": "发呆可以，别把我也忘了。",
              "en-US": "Daydream if you must, but don't forget I'm here."
            },
            "weight": 2
          }
        ]
      },
      "stateAnimations": [
        {
          "priority": 90,
          "match": {
            "form": "attack"
          },
          "animation": "attack-hmph"
        },
        {
          "priority": 90,
          "match": {
            "form": "demon"
          },
          "animation": "demon-hmph"
        }
      ]
    },
    "weekday-afternoon-hmph": {
      "label": {
        "zh-CN": "工作日下午轻哼",
        "en-US": "Weekday afternoon hmph"
      },
      "animation": "hmph",
      "priority": 31,
      "cooldownMs": 72000000,
      "interruptible": true,
      "dialogue": {
        "chance": 0.9,
        "delayMs": 100,
        "durationMs": 2300,
        "anchor": {
          "x": 352,
          "y": 170
        },
        "lines": [
          {
            "text": {
              "zh-CN": "午后最容易松懈。别让我抓到。",
              "en-US": "Afternoons invite carelessness. Don't let me catch you slacking."
            },
            "weight": 3
          },
          {
            "text": {
              "zh-CN": "困了就喝口水，逞强可不算本事。",
              "en-US": "If you're sleepy, drink some water. Stubbornness isn't a talent."
            },
            "weight": 2
          }
        ]
      },
      "stateAnimations": [
        {
          "priority": 90,
          "match": {
            "form": "attack"
          },
          "animation": "attack-hmph"
        },
        {
          "priority": 90,
          "match": {
            "form": "demon"
          },
          "animation": "demon-hmph"
        }
      ]
    },
    "monday-afternoon-reminder": {
      "label": {
        "zh-CN": "周一下午提醒",
        "en-US": "Monday afternoon reminder"
      },
      "animation": "remind",
      "priority": 37,
      "cooldownMs": 72000000,
      "interruptible": true,
      "dialogue": {
        "chance": 1,
        "delayMs": 100,
        "durationMs": 2400,
        "anchor": {
          "x": 350,
          "y": 158
        },
        "lines": [
          {
            "text": {
              "zh-CN": "周一也没什么可怕的。跟上我的拍子。",
              "en-US": "Monday is nothing to fear. Keep pace with me."
            },
            "weight": 3
          },
          {
            "text": {
              "zh-CN": "才周一就没精神？坐直。",
              "en-US": "Already wilting on Monday? Sit up straight."
            },
            "weight": 2
          }
        ]
      },
      "stateAnimations": [
        {
          "priority": 90,
          "match": {
            "form": "attack"
          },
          "animation": "attack-remind"
        },
        {
          "priority": 90,
          "match": {
            "form": "demon"
          },
          "animation": "demon-remind"
        }
      ]
    },
    "midnight-reminder": {
      "label": {
        "zh-CN": "深夜休息提醒",
        "en-US": "Late-night reminder"
      },
      "animation": "remind",
      "priority": 44,
      "cooldownMs": 72000000,
      "interruptible": true,
      "dialogue": {
        "chance": 1,
        "delayMs": 100,
        "durationMs": 2600,
        "anchor": {
          "x": 350,
          "y": 158
        },
        "lines": [
          {
            "text": {
              "zh-CN": "夜深了。再不收琴，我替你合上。",
              "en-US": "It's late. If you won't stop, I'll close the instrument for you."
            },
            "weight": 3
          },
          {
            "text": {
              "zh-CN": "我没有催你睡，只是不想听你明日喊困。",
              "en-US": "I'm not sending you to bed. I just don't want to hear you complain tomorrow."
            },
            "weight": 2
          }
        ]
      },
      "stateAnimations": [
        {
          "priority": 90,
          "match": {
            "form": "attack"
          },
          "animation": "attack-remind"
        },
        {
          "priority": 90,
          "match": {
            "form": "demon"
          },
          "animation": "demon-remind"
        }
      ]
    }
