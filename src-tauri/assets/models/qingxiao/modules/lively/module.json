    "sword-qi-focus": {
      "label": {
        "zh-CN": "剑气凝心",
        "en-US": "Focus sword qi"
      },
      "animation": "sword-qi-focus",
      "priority": 24,
      "cooldownMs": 18000,
      "interruptible": true,
      "dialogue": {
        "chance": 1,
        "delayMs": 120,
        "durationMs": 2200,
        "anchor": {
          "x": 356,
          "y": 170
        },
        "lines": [
          {
            "text": {
              "zh-CN": "一念成锋。",
              "en-US": "One thought becomes an edge."
            },
            "weight": 3
          },
          {
            "text": {
              "zh-CN": "剑气凝心，去。",
              "en-US": "Sword qi, heed my will."
            },
            "weight": 2
          }
        ]
      },
      "stateDialogues": [
        {
          "priority": 90,
          "match": {
            "form": "attack"
          },
          "dialogue": {
            "chance": 1,
            "delayMs": 100,
            "durationMs": 2100,
            "anchor": {
              "x": 356,
              "y": 170
            },
            "lines": [
              {
                "text": {
                  "zh-CN": "锋起，破妄。",
                  "en-US": "Edge rise—shatter illusion."
                },
                "weight": 3
              },
              {
                "text": {
                  "zh-CN": "这一剑，不留余地。",
                  "en-US": "This strike leaves no quarter."
                },
                "weight": 2
              }
            ]
          }
        },
        {
          "priority": 90,
          "match": {
            "form": "demon"
          },
          "dialogue": {
            "chance": 1,
            "delayMs": 140,
            "durationMs": 2300,
            "anchor": {
              "x": 356,
              "y": 170
            },
            "lines": [
              {
                "text": {
                  "zh-CN": "呵……这道剑气，可没那么温柔。",
                  "en-US": "Heh… this sword qi is not so gentle."
                },
                "weight": 3
              },
              {
                "text": {
                  "zh-CN": "现在后悔，晚了。",
                  "en-US": "Too late for regrets."
                },
                "weight": 2
              }
            ]
          }
        }
      ],
      "stateAnimations": [
        {
          "priority": 90,
          "match": {
            "form": "attack"
          },
          "animation": "attack-sword-qi-focus"
        },
        {
          "priority": 90,
          "match": {
