      "interactions": [
        {
          "id": "qingxiao-head-hover",
          "label": {
            "zh-CN": "靠近看看",
            "en-US": "Take a closer look"
          },
          "event": "hover",
          "area": "head",
          "animation": "pet-curious",
          "holdMs": 700,
          "cooldownMs": 4500
        },
        {
          "id": "qingxiao-head-tap",
          "label": {
            "zh-CN": "轻点额头",
            "en-US": "Tap her forehead"
          },
          "event": "tap",
          "area": "head",
          "animation": "pet-content",
          "distance": 6,
          "windowMs": 420,
          "cooldownMs": 1800
        },
        {
          "id": "qingxiao-head-stroke",
          "label": {
            "zh-CN": "抚摸头发",
            "en-US": "Stroke her hair"
          },
          "event": "stroke",
          "area": "head",
          "animation": "pet-content",
          "distance": 72,
          "windowMs": 1200,
          "cooldownMs": 2200
        },
        {
          "id": "qingxiao-qin-tap",
          "label": {
            "zh-CN": "轻点琴弦",
            "en-US": "Tap the strings"
          },
          "event": "tap",
          "area": "qin",
          "animation": "pet-chime",
          "distance": 6,
          "windowMs": 420,
          "cooldownMs": 1400
        },
        {
          "id": "qingxiao-qin-stroke",
          "label": {
            "zh-CN": "拂过琴弦",
            "en-US": "Brush across the strings"
          },
          "event": "stroke",
          "area": "qin",
          "animation": "pet-chime",
          "distance": 68,
          "windowMs": 1100,
          "cooldownMs": 1000
        }
      ]
    }
